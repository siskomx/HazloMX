{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hazlo Mexa",
  "version": "0.1.0",
  "identifier": "mx.hazlomexa.desktop",
  "build": {
    "beforeDevCommand": "python ../../tests/kicad/build_worker.py && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "python ../../tests/build_rea_runtime.py && python ../../tests/kicad/build_worker.py && npm run build && cargo build -p hazlomexa --release --bin hazlomexa-tools",
    "frontendDist": "../dist",
    "features": ["desktop"]
  },
  "app": {
    "windows": [{ "label": "main", "title": "Hazlo Mexa", "width": 1150, "height": 820, "minWidth": 800, "minHeight": 650 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "resources": { "../../../target/release/hazlomexa-tools.exe": "hazlomexa-tools.exe", "../../../target/bundled-rea/node.exe": "rea/node.exe", "../../../target/bundled-rea/LICENSE": "rea/LICENSE", "../../../target/bundled-rea/node_modules/": "rea/node_modules/", "../../../target/bundled-rea/runtime-identity.json": "rea/runtime-identity.json" },
    "targets": ["nsis"],
    "copyright": "Copyright © 2026 siskomx",
    "shortDescription": "Propuestas verificadas y archivos CAD con aprobación explícita",
    "icon": ["icons/icon.ico", "icons/128x128.png"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Spanish", "English"], "displayLanguageSelector": true },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false }
    }
  }
}
