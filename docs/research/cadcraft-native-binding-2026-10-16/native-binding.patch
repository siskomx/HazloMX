+++ b/crates/ui-egui/tests/control_binding.rs
@@ -0,0 +1,117 @@
+use cadcraft_engine::Session;
+use cadcraft_ui_egui::control::{ControlRequest, Outcome, handle};
+use cadcraft_ui_egui::{CadApp, Services};
+use serde_json::{Value, json};
+
+fn call(app: &mut CadApp, ctx: &egui::Context, method: &str, params: Value) -> Value {
+    let (request, _) = ControlRequest::new(method, params);
+    match handle(app, ctx, &request) {
+        Outcome::Done(value) => value,
+        Outcome::Screenshot { .. } => panic!("Unexpected screenshot"),
+    }
+}
+fn line(app: &mut CadApp, ctx: &egui::Context, binding: Value) -> Value {
+    call(app, ctx, "engine.execute_checked", json!({"expected":binding,"command":"line","params":{"points":[[0,0],[10,0]]}}))
+}
+fn setup() -> (CadApp, egui::Context) {
+    (CadApp::new(Session::new(), Services::default()), egui::Context::default())
+}
+
+#[test]
+fn matching_binding_executes_once_and_records_native_undo() {
+    let (mut app, ctx) = setup();
+    let binding = call(&mut app, &ctx, "document.binding", json!({}))["result"].clone();
+    assert_eq!(line(&mut app, &ctx, binding.clone())["ok"], true);
+    assert_eq!(app.session.state().unwrap().doc.model.iter().count(), 1);
+    assert_eq!(app.session.state().unwrap().undo.len(), 1);
+    assert_eq!(line(&mut app, &ctx, binding)["ok"], false);
+    assert_eq!(app.session.state().unwrap().doc.model.iter().count(), 1);
+}
+
+#[test]
+fn unprojected_layer_lineweight_invalidates_binding_without_an_edit() {
+    let (mut app, ctx) = setup();
+    let before = call(&mut app, &ctx, "drawing.inspect", json!({}));
+    let binding = call(&mut app, &ctx, "document.binding", json!({}))["result"].clone();
+    assert_eq!(call(&mut app, &ctx, "engine.execute", json!({"command":"layer.set","params":{"name":"0","lineweight":0.5}}))["ok"], true);
+    let after = call(&mut app, &ctx, "drawing.inspect", json!({}));
+    assert_eq!(before["result"]["layers"], after["result"]["layers"]);
+    assert_eq!(line(&mut app, &ctx, binding)["ok"], false);
+    assert_eq!(app.session.state().unwrap().doc.model.iter().count(), 0);
+}
+
+#[test]
+fn another_native_read_invalidates_the_previous_token() {
+    let (mut app, ctx) = setup();
+    let old = call(&mut app, &ctx, "document.binding", json!({}))["result"].clone();
+    let current = call(&mut app, &ctx, "document.binding", json!({}))["result"].clone();
+    assert_ne!(old, current);
+    assert_eq!(line(&mut app, &ctx, old)["ok"], false);
+    assert_eq!(line(&mut app, &ctx, current)["ok"], true);
+}
+
+#[test]
+fn changed_native_selection_refuses_dispatch() {
+    let (mut app, ctx) = setup();
+    assert_eq!(call(&mut app, &ctx, "engine.execute", json!({"command":"line","params":{"points":[[0,0],[1,0]]}}))["ok"], true);
+    let handle = app.session.state().unwrap().doc.model.iter().next().unwrap().handle;
+    app.session.state_mut().unwrap().selection.clear();
+    let binding = call(&mut app, &ctx, "document.binding", json!({}))["result"].clone();
+    app.session.state_mut().unwrap().selection.push(handle);
+    assert_eq!(line(&mut app, &ctx, binding)["ok"], false);
+    assert_eq!(app.session.state().unwrap().doc.model.iter().count(), 1);
+}
+
+#[test]
+fn an_interactive_command_refuses_dispatch_without_cancelling_it() {
+    let (mut app, ctx) = setup();
+    let binding = call(&mut app, &ctx, "document.binding", json!({}))["result"].clone();
+    app.session.start("line").unwrap();
+    assert!(app.session.running.is_some());
+    assert_eq!(call(&mut app, &ctx, "document.binding", json!({}))["ok"], false);
+    assert_eq!(line(&mut app, &ctx, binding)["ok"], false);
+    assert!(app.session.running.is_some());
+    assert_eq!(app.session.state().unwrap().doc.model.iter().count(), 0);
+}
+
+#[test]
+fn changed_previous_selection_refuses_dispatch() {
+    let (mut app, ctx) = setup();
+    let binding = call(&mut app, &ctx, "document.binding", json!({}))["result"].clone();
+    app.session.state_mut().unwrap().previous_selection.push(cadcraft_engine::doc::Handle(1));
+    assert_eq!(line(&mut app, &ctx, binding)["ok"], false);
+    assert_eq!(app.session.state().unwrap().doc.model.iter().count(), 0);
+}
+
+#[test]
+fn changed_undo_settings_refuse_dispatch() {
+    let (mut app, ctx) = setup();
+    let binding = call(&mut app, &ctx, "document.binding", json!({}))["result"].clone();
+    app.session.state_mut().unwrap().undo_ctl.auto = false;
+    assert_eq!(line(&mut app, &ctx, binding)["ok"], false);
+    assert_eq!(app.session.state().unwrap().doc.model.iter().count(), 0);
+}
+
+#[test]
+fn unavailable_independent_undo_refuses_dispatch() {
+    for grouped in [false, true] {
+        let (mut app, ctx) = setup();
+        if grouped {
+            app.session.state_mut().unwrap().undo_ctl.group = Some(0);
+        } else {
+            app.session.state_mut().unwrap().undo_ctl.control = cadcraft_engine::undoctl::Control::None;
+        }
+        let binding = call(&mut app, &ctx, "document.binding", json!({}))["result"].clone();
+        assert_eq!(line(&mut app, &ctx, binding)["ok"], false);
+        assert_eq!(app.session.state().unwrap().doc.model.iter().count(), 0);
+    }
+}
+
+#[test]
+fn another_document_with_identical_geometry_refuses_dispatch() {
+    let (mut app, ctx) = setup();
+    let binding = call(&mut app, &ctx, "document.binding", json!({}))["result"].clone();
+    app.session.new_drawing(true);
+    assert_eq!(line(&mut app, &ctx, binding)["ok"], false);
+    assert_eq!(app.session.state().unwrap().doc.model.iter().count(), 0);
+}
