+// Keep the native immutable drawing alive: every engineering write must copy it.
+#[derive(Clone)]
+struct DocumentBinding {
+    token: String,
+    uid: u64,
+    revision: u64,
+    drawing: Arc<cadcraft_engine::doc::Drawing>,
+    path: Option<String>,
+    dirty: bool,
+    context: String,
+}
+fn binding_key() -> egui::Id {
+    egui::Id::new("cadcraft-native-document-binding")
+}
+// shortcut: bind other session settings before enabling commands that depend on them.
+fn binding_context(state: &cadcraft_engine::DocState) -> String {
+    format!(
+        "{:?}",
+        (
+            &state.space,
+            state.mspace,
+            state.block_editor(),
+            &state.selection,
+            &state.previous_selection,
+            &state.undo_ctl,
+            state.undo.len(),
+            state.redo.len()
+        )
+    )
+}
+fn binding_idle(app: &CadApp) -> Result<(), String> {
+    if app.session.running.is_some() || app.session.suspended.is_some() || app.session.lisp_running() {
+        return Err("finish the active native command first".into());
+    }
+    Ok(())
+}
+fn document_binding(app: &CadApp, ctx: &egui::Context) -> Result<Value, String> {
+    binding_idle(app)?;
+    static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+    let state = app.session.state().map_err(|e| e.to_string())?;
+    let token = NEXT.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| n.checked_add(1)).map_err(|_| "binding limit reached")?.to_string();
+    let binding = DocumentBinding {
+        token: token.clone(),
+        uid: state.uid,
+        revision: state.revision,
+        drawing: state.doc.clone(),
+        path: state.path.clone(),
+        dirty: state.is_dirty(),
+        context: binding_context(state),
+    };
+    ctx.data_mut(|data| data.insert_temp(binding_key(), binding));
+    Ok(json!({"token": token}))
+}
+
 pub fn handle(app: &mut CadApp, ctx: &egui::Context, req: &ControlRequest) -> Outcome {
     let p = &req.params;
     let s = |k: &str| p.get(k).and_then(Value::as_str);
     let f = |k: &str| p.get(k).and_then(Value::as_f64);
     match req.method.as_str() {
+        "document.binding" => wrap(document_binding(app, ctx)),
+        "engine.execute_checked" => {
+            if let Err(e) = binding_idle(app) {
+                return err(e);
+            }
+            let Some(binding) = ctx.data_mut(|data| data.get_temp::<DocumentBinding>(binding_key())) else { return err("no native binding") };
+            let state = match app.session.state() {
+                Ok(v) => v,
+                Err(e) => return err(e),
+            };
+            if p.get("expected") != Some(&json!({"token":binding.token}))
+                || state.uid != binding.uid
+                || state.revision != binding.revision
+                || !Arc::ptr_eq(&state.doc, &binding.drawing)
+                || state.path != binding.path
+                || state.is_dirty() != binding.dirty
+                || binding_context(state) != binding.context
+            {
+                return err("document binding changed");
+            }
+            if state.undo_ctl.control == cadcraft_engine::undoctl::Control::None || state.undo_ctl.group.is_some() {
+                return err("native undo must be enabled without an open group");
+            }
+            let Some(id) = s("command") else { return err("missing `command`") };
+            let Some(params) = p.get("params").filter(|v| v.is_object()) else { return err("missing object `params`") };
+            ctx.data_mut(|data| data.remove::<DocumentBinding>(binding_key()));
+            wrap(app.session.execute(id, params).map_err(|e| e.to_string()))
+        }
         "engine.execute" | "command" => {
             let Some(id) = s("command").or(s("id")) else { return err("missing `command`") };
             let params = p.get("params").cloned().unwrap_or(json!({}));
