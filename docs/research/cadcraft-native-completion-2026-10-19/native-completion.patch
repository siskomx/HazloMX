+fn execute_recorded(app: &mut CadApp, ctx: &egui::Context, p: &Value) -> Result<Value, String> {
+    use std::{fs::OpenOptions, io::Write, path::Path};
+    let command = p["command"].as_str().ok_or("missing command")?;
+    let identity = p["input_sha256"].as_str().ok_or("missing input identity")?;
+    let destination = Path::new(p["receipt_path"].as_str().ok_or("missing receipt path")?);
+    #[cfg(windows)]
+    if !matches!(destination.components().next(), Some(std::path::Component::Prefix(prefix)) if matches!(prefix.kind(), std::path::Prefix::Disk(_) | std::path::Prefix::VerbatimDisk(_)))
+    {
+        return Err("receipt requires a local drive".into());
+    }
+    if p.as_object().map(|p| p.len()) != Some(5)
+        || !matches!(command, "circle" | "move" | "document.bytes")
+        || identity.len() != 64
+        || !identity.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        || !destination.is_absolute()
+        || destination.file_name().and_then(|n| n.to_str()) != Some("drawing-completion.json")
+        || destination.try_exists().map_err(|_| "receipt unavailable")?
+    {
+        return Err("invalid recorded operation".into());
+    }
+    let pending = destination.with_file_name("drawing-completion.json.pending");
+    // Reserve before native execution; a failed or interrupted attempt cannot reuse this slot.
+    let mut output = OpenOptions::new().write(true).create_new(true).open(&pending).map_err(|_| "receipt already reserved or unavailable")?;
+    let proof = if checked_preflight(app, ctx, p).is_err() {
+        json!({"version":1,"input_sha256":identity,"outcome":"not_dispatched"})
+    } else {
+        let (request, _) = ControlRequest::new("engine.execute_checked", json!({"expected":p["expected"],"command":command,"params":p["params"]}));
+        let result = match handle(app, ctx, &request) {
+            Outcome::Done(value) if value["ok"] == true => value["result"].clone(),
+            _ => return Err("native outcome unavailable; preserve the receipt reservation".into()),
+        };
+        let after = document_observe(app, ctx)?;
+        json!({"version":1,"input_sha256":identity,"outcome":"completed","command_result":result,"after":after})
+    };
+    let bytes = serde_json::to_vec(&proof).map_err(|_| "completion unavailable")?;
+    if bytes.len() > 256 * 1024 {
+        return Err("completion exceeds retention limit; do not repeat the operation".into());
+    }
+    output.write_all(&bytes).and_then(|_| output.sync_all()).map_err(|_| "completion not retained; do not repeat the operation")?;
+    drop(output);
+    // Unlike rename on some platforms, link cannot replace an existing final receipt.
+    std::fs::hard_link(&pending, destination).map_err(|_| "completion publication unconfirmed; do not repeat the operation")?;
+    std::fs::remove_file(pending).map_err(|_| "completion retained; pending cleanup required")?;
+    Ok(proof)
+}
