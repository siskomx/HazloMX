+fn receipt_directory() -> std::path::PathBuf {
+    let root = std::env::temp_dir().join(format!(
+        "cadcraft-completion-{}-{}",
+        std::process::id(),
+        std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()
+    ));
