+#[test]
+fn recorded_completion_precedes_reply_and_preserves_later_manual_edits() {
+    let (mut app, ctx) = setup();
+    let root = receipt_directory();
+    let before = call(&mut app, &ctx, "document.observe", json!({}));
+    let reply = recorded(&mut app, &ctx, &root, before["result"]["binding"].clone());
+    assert_eq!(reply["ok"], true, "{reply}");
+    let bytes = std::fs::read(root.join("drawing-completion.json")).unwrap();
+    let proof: Value = serde_json::from_slice(&bytes).unwrap();
+    assert_eq!(proof, reply["result"]);
+    assert_eq!(proof["input_sha256"], "a".repeat(64));
+    assert_eq!(proof["after"]["drawing"]["entityCount"], 1);
+    assert!(!root.join("drawing-completion.json.pending").exists());
+    assert_eq!(call(&mut app, &ctx, "engine.execute", json!({"command":"circle","params":{"center":[4,5],"diameter":3}}))["ok"], true);
+    assert_eq!(recorded(&mut app, &ctx, &root, before["result"]["binding"].clone())["ok"], false);
+    assert_eq!(app.session.state().unwrap().doc.entity_count(), 2);
+    assert_eq!(std::fs::read(root.join("drawing-completion.json")).unwrap(), bytes);
+    std::fs::remove_dir_all(root).unwrap();
+}
