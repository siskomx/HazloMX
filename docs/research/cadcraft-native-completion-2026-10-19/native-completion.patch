+fn checked_preflight(app: &CadApp, ctx: &egui::Context, p: &Value) -> Result<(), String> {
+    binding_idle(app)?;
+    let binding = ctx.data_mut(|data| data.get_temp::<DocumentBinding>(binding_key())).ok_or("no native binding")?;
+    let state = app.session.state().map_err(|e| e.to_string())?;
+    if p.get("expected") != Some(&json!({"token":binding.token}))
+        || state.uid != binding.uid
+        || state.revision != binding.revision
+        || !Arc::ptr_eq(&state.doc, &binding.drawing)
+        || state.path != binding.path
+        || state.is_dirty() != binding.dirty
+        || binding_context(state) != binding.context
+    {
+        return Err("document binding changed".into());
+    }
+    let id = p["command"].as_str().ok_or("missing `command`")?;
+    if id != "document.bytes" && (state.undo_ctl.control == cadcraft_engine::undoctl::Control::None || state.undo_ctl.group.is_some()) {
+        return Err("native undo must be enabled without an open group".into());
+    }
+    if !p["params"].is_object() {
+        return Err("missing object `params`".into());
+    }
+    Ok(())
+}
