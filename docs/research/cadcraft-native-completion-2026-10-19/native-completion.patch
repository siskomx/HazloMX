+#[test]
+fn refused_or_reserved_recorded_calls_never_repeat_or_replace_work() {
+    for mode in ["changed", "pending", "existing"] {
+        let (mut app, ctx) = setup();
+        let root = receipt_directory();
+        let binding = call(&mut app, &ctx, "document.binding", json!({}))["result"].clone();
+        if mode == "changed" {
+            assert_eq!(call(&mut app, &ctx, "engine.execute", json!({"command":"layer.set","params":{"name":"0","lineweight":0.5}}))["ok"], true);
+        } else {
+            std::fs::write(
+                root.join(if mode == "pending" { "drawing-completion.json.pending" } else { "drawing-completion.json" }),
+                b"preserve prior work",
+            )
+            .unwrap();
+        }
+        let before = app.session.summary();
+        let first = recorded(&mut app, &ctx, &root, binding.clone());
+        if mode == "changed" {
+            assert_eq!(first["ok"], true);
+            assert_eq!(first["result"]["outcome"], "not_dispatched");
+        } else {
+            assert_eq!(first["ok"], false);
+        }
+        assert_eq!(recorded(&mut app, &ctx, &root, binding)["ok"], false);
+        assert_eq!(app.session.summary(), before);
+        assert_eq!(app.session.state().unwrap().doc.entity_count(), 0);
+        if mode == "changed" {
+            assert!(root.join("drawing-completion.json").exists());
+            assert!(!root.join("drawing-completion.json.pending").exists());
+        } else {
+            assert_eq!(
+                std::fs::read(root.join(if mode == "pending" { "drawing-completion.json.pending" } else { "drawing-completion.json" })).unwrap(),
+                b"preserve prior work"
+            );
+        }
+        std::fs::remove_dir_all(root).unwrap();
+    }
