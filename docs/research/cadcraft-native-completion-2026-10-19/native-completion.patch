+#[test]
+fn recorded_export_retains_exact_bytes_without_saving_the_source() {
+    cadcraft_engine::cmd::file::set_io(cadcraft_engine::cmd::file::IoHooks {
+        read: |_, _| Err("not used by this dispatch test".into()),
+        write: |_, _| Ok(b"owned dispatch test bytes".to_vec()),
+        plot: None,
+    });
+    let (mut app, ctx) = setup();
+    let root = receipt_directory();
+    let before = app.session.summary();
+    let binding = call(&mut app, &ctx, "document.binding", json!({}))["result"].clone();
+    let reply = call(
+        &mut app,
+        &ctx,
+        "engine.execute_recorded",
+        json!({"expected":binding,"command":"document.bytes","params":{"format":"dxf"},"input_sha256":"a".repeat(64),"receipt_path":root.join("drawing-completion.json")}),
+    );
+    assert_eq!(reply["ok"], true, "{reply}");
+    assert!(reply["result"]["command_result"]["bytes"].as_u64().unwrap() > 0);
+    assert_eq!(app.session.summary(), before);
+    assert_eq!(app.session.state().unwrap().undo.len(), 0);
+    let proof: Value = serde_json::from_slice(&std::fs::read(root.join("drawing-completion.json")).unwrap()).unwrap();
+    assert_eq!(proof, reply["result"]);
+    std::fs::remove_dir_all(root).unwrap();
+}
